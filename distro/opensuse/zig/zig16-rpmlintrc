# rpmlint configuration for zig16
# Suppress false positives for Zig stdlib files

# Zig bundles its standard library including C headers and C++ sources
# These are intentionally included as part of the toolchain
addFilter("zig16.* devel-file-in-non-devel-package .*/zig-0.16.0/lib/")

# Zig stdlib is stripped for release builds
addFilter("zig16.* unstripped-binary-or-object .*/zig-0.16.0/zig")

# Binary is not PIE, but this is upstream's choice
addFilter("zig16.* position-independent-executable-suggested .*/zig-0.16.0/zig")
